show()"],"metadata":{"id":"Z54vAp2tkkoM","executionInfo":{"status":"ok","timestamp":1765544694557,"user_tz":-120,"elapsed":760,"user":{"displayName":"Haidy","userId":"17526276945697867085"}},"colab":{"base_uri":"https://localhost:8080/","height":487},"outputId":"496d2c2d-8798-472a-dd52-b92e8194f72a"},"execution_count":38,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["#       EVALUATION METRICS\n","from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n","import math\n","def regression_metrics(y_true, y_pred):\n","    mse = mean_squared_error(y_true, y_pred)\n","    rmse = math.sqrt(mse)\n","    mae = mean_absolute_error(y_true, y_pred)\n","    r2  = r2_score(y_true, y_pred)\n","    return {'MSE': mse, 'RMSE': rmse, 'MAE': mae, 'R2': r2}\n","print(\"===== KNN Regressor Evaluation Metrics =====\")\n","metrics_knn = regression_metrics(y_test, y_pred)\n","metrics_df = pd.DataFrame([metrics_knn], index=['KNN'])\n","print(metrics_df)\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"X8_QpIqasegZ","executionInfo":{"status":"ok","timestamp":1765544829922,"user_tz":-120,"elapsed":118,"user":{"displayName":"Haidy","userId":"17526276945697867085"}},"outputId":"1221e6e1-9652-472e-c581-f5c6c659273d"},"execution_count":40,"outputs":[{"output_type":"stream","name":"stdout","text":["===== KNN Regressor Evaluation Metrics =====\n","          MSE      RMSE      MAE        R2\n","KNN  5.475755  2.340033  1.84335  0.985067\n"]}]},{"cell_type":"code","source":["#       PREDICTED VS ACTUAL PLOT\n","plt.figure(figsize=(6,6))\n","plt.scatter(y_test, y_pred, color='blue')\n","plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--')\n","plt.xlabel(\"Actual Values\")\n","plt.ylabel(\"Predicted Values\")\n","plt.title(\"KNN Regressor: Predicted vs Actual\")\n","plt.grid()\n","plt.show()"],"metadata":{"colab":{"